DATABASE_MODE=aws

# Provide AWS credentials here if running from an environment without an attached IAM role
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Optional: override full database URL
# DATABASE_URL=

# Local Postgres settings for development (uncomment when using local DB)
# DATABASE_MODE=local
# POSTGRES_DB=dicejobmanager
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# Environment variables for DiceCalculatorFastAPI
# When running the API in Docker, use the compose service name 'postgres' as the host.
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/dicejobmanager
DATABASE_MODE=aws

AWS_REGION=ap-southeast-2
AWS_DB_HOST=dice-job-db.cluster-c5osco4isnq0.ap-southeast-2.rds.amazonaws.com
AWS_DB_PORT=5432
AWS_DB_NAME=dicejobmanager
AWS_DB_USER=diceapp