# Create these files with your credentials and DO NOT commit them to source control.
# Example:
# echo "AKIA..." > secrets/aws_access_key_id
# echo "wJalrXUtnFEMI/K7MDENG/bPxRfiCYzEXAMPLEKEY" > secrets/aws_secret_access_key
# echo "<optional session token>" > secrets/aws_session_token

# Paths used by docker-compose secrets: ./secrets/aws_access_key_id, ./secrets/aws_secret_access_key, ./secrets/aws_session_token

# Create a folder named 'secrets' in the project root and place these files inside.
# Ensure permissions restrict access: chmod 600 secrets/*
