# Example env for AWS RDS IAM auth (production) and local dev fallback

# Choose mode: "aws" to use RDS IAM auth, "local" to use local Postgres
DATABASE_MODE=aws

# --- AWS RDS (IAM auth) settings ---
AWS_REGION=ap-southeast-2
AWS_DB_HOST=dice-job-db.cluster-c5osco4isnq0.ap-southeast-2.rds.amazonaws.com
AWS_DB_PORT=5432
AWS_DB_NAME=dicejobmanager
AWS_DB_USER=diceapp

# For local testing you can provide AWS credentials here (or rely on container IAM role)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# --- Optional override: supply a full DATABASE_URL instead of building one
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# --- Local Postgres dev settings (set DATABASE_MODE=local to use these) ---
# These match the local container used by docker-compose.override.yml
POSTGRES_DB=dicejobmanager
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
