# Local Postgres on the Docker host (192.168.0.45:5432)
DATABASE_MODE=local
POSTGRES_DB=dicejobmanager
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@192.168.0.45:5432/dicejobmanager

